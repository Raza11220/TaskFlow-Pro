NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow_pro

JWT_ACCESS_SECRET=replace_with_secure_random_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_another_secure_random_secret_at_least_32_characters_long
GOOGLE_CLIENT_ID=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TaskFlow Pro <no-reply@taskflowpro.com>"

APP_NAME=TaskFlow Pro
APP_TIMEZONE=Asia/Karachi
LOG_LEVEL=info
MAX_FILE_SIZE_MB=10
