{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "src/routes/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    { "path": "/api/jobs/daily", "schedule": "0 4 * * *" }
  ]
}
